# PumpPortal API (required)
PUMPPORTAL_API_KEY=your_pumpportal_api_key

# Wallet (required)
WALLET_PUBLIC_KEY=your_wallet_public_key
WALLET_PRIVATE_KEY=your_wallet_private_key

# RPC (required - use Helius, Quicknode, or similar for best performance)
RPC_URL=https://api.mainnet-beta.solana.com

# Supabase (required)
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Token Data API (optional)
BIRDEYE_API_KEY=your_birdeye_api_key

# Bot Config (defaults, overridable via BOT_CONFIG.json)
DEFAULT_AMOUNT_USD=20
DEFAULT_TP_PERCENT=15
DEFAULT_SL_PERCENT=10
DEFAULT_TIMEOUT_MINUTES=5
DEFAULT_TIMEOUT_THRESHOLD=5
DEFAULT_MAX_POSITIONS=5
DEFAULT_SLIPPAGE=15
DEFAULT_PRIORITY_FEE=0.0001

# Mode (set to false for live trading - BE CAREFUL!)
DRY_RUN=true
STARTING_BALANCE_SOL=10
TRADE_AMOUNT_USD=20
