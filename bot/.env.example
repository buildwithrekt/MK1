# PumpPortal API
PUMPPORTAL_API_KEY=your_pumpportal_api_key

# Wallet (from PumpPortal or your own)
WALLET_PUBLIC_KEY=your_wallet_public_key
WALLET_PRIVATE_KEY=your_wallet_private_key

# RPC (for transaction submission - use a fast RPC like Helius, Quicknode, etc.)
RPC_URL=https://api.mainnet-beta.solana.com

# Supabase (optional - for dashboard and trade history)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Bot Config (defaults, overridable via dashboard)
DEFAULT_AMOUNT_SOL=0.1
DEFAULT_TP_PERCENT=15
DEFAULT_SL_PERCENT=10
DEFAULT_TIMEOUT_MINUTES=5
DEFAULT_TIMEOUT_THRESHOLD=5
DEFAULT_MAX_POSITIONS=5
DEFAULT_SLIPPAGE=15
DEFAULT_PRIORITY_FEE=0.0001

# Mode (set to false for live trading - BE CAREFUL!)
DRY_RUN=true
