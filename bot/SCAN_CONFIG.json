{
  "scanner": {
    "websocket_url": "wss://pumpportal.fun/api/data",
    "reconnect_delay_ms": 3000,
    "max_reconnect_attempts": 10
  },
  "monitoring": {
    "min_initial_market_cap_usd": 4000,
    "monitoring_duration_seconds": 480,
    "max_tokens_monitored": 200
  },
  "entry_filters": {
    "dev_must_sell": true,
    "min_market_cap_usd": 6000,
    "max_market_cap_usd": 45000,
    "min_buy_volume_usd": 2000,
    "min_unique_buyers": 25,
    "buy_sell_ratio": 1.0
  },
  "birdeye_filters": {
    "enabled": true,
    "min_liquidity_usd": 500,
    "max_progress_percent": 99,
    "require_socials": false,
    "min_token_age_seconds": 1,
    "creator_blacklist": []
  },
  "logging": {
    "new_tokens": true,
    "token_entered_zone": true,
    "momentum_box": true,
    "errors": true
  },
  "database": {
    "save_logs": true,
    "max_logs": 500
  },
  "terminal": {
    "show_new_tokens": false,
    "show_monitoring_count": true,
    "show_zone_entries": true,
    "show_momentum": true,
    "show_system_logs": false
  }
}
