# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# RPC (optional - for balance checks)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_key
RPC_URL=https://api.mainnet-beta.solana.com

# Wallet (optional - for display on dashboard)
WALLET_PUBLIC_KEY=your_wallet_public_key

# Token Data (optional)
BIRDEYE_API_KEY=your_birdeye_api_key

# Bot Config Display (optional)
STARTING_BALANCE_SOL=10

# Claude API (optional - for trade analysis)
CLAUDE_API_KEY=your_claude_api_key

# Site URL (optional)
NEXT_PUBLIC_WEBSITE_URL=https://your-domain.com
